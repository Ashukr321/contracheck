{
  "name": "contracheck",
  "version": "1.0.0",
  "description": "Tiny zero-dependency color contrast toolkit — WCAG 2.1 AA/AAA checking, contrast ratios, color suggestions, palette audit. Supports HEX, RGB, HSL, OKLCH, HWB & CSS named colors.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "color",
    "contrast",
    "contrast-ratio",
    "color-contrast",
    "wcag",
    "wcag-2.1",
    "accessibility",
    "a11y",
    "aa",
    "aaa",
    "color-checker",
    "color-suggestion",
    "luminance",
    "relative-luminance",
    "hex",
    "rgb",
    "hsl",
    "oklch",
    "hwb",
    "css-colors",
    "palette",
    "palette-checker",
    "design-system",
    "design-tokens",
    "text-color",
    "readable-color",
    "color-accessibility",
    "react-hook",
    "typescript",
    "tree-shakeable",
    "zero-dependency"
  ],
  "author": "Ashukr321",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ashukr321/contracheck"
  },
  "bugs": {
    "url": "https://github.com/Ashukr321/contracheck/issues"
  },
  "homepage": "https://github.com/Ashukr321/contracheck#readme",
  "devDependencies": {
    "@types/react": "^19.2.18",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
